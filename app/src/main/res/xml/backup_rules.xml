<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Auth tokens must never be backed up — restoring them on another device = active session without password -->
    <exclude domain="file" path="datastore/auth_prefs.preferences_pb"/>
    <!-- Encrypted session store (012): its Keystore key never travels, so a restored copy could never open -->
    <exclude domain="file" path="datastore/auth_prefs.enc.preferences_pb"/>
</full-backup-content>